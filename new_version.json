    "/user/content/{id}": {
      "get": {
        "summary": "Lesson detail",
        "deprecated": false,
        "description": "One lesson with its attachments, its article body and the caller's progress.\n\nThis is the only endpoint that returns `article_body`, and only for an unlocked lesson. It also adds `subject_name` and `attachments`, neither of which appears in the listing. \r\n\r\n                            A locked lesson returns 403 because the previous lesson in the same subject has not been completed. Show the `message` from the body; it is already localised. \r\n\r\n                            Requesting a lesson from a class the student is not enrolled in returns 403 and writes a security event recording the student, the lesson, the device and the app version. Lessons from a class the student has finished stay readable.\n\n### Path parameters\n\n- `id` — *integer*, required. Lesson id.",
        "tags": [
          "Student/Content/Lessons"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "",
            "required": true,
            "example": "",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Accept",
            "in": "header",
            "description": "",
            "required": true,
            "example": "application/json",
            "schema": {
              "type": "string"
            }
